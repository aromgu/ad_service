# ===== App =====
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ===== Model =====
# 사용할 멀티모달 VLM (예: Qwen/Qwen2-VL-7B-Instruct, llava-hf/llava-1.5-7b-hf 등)
VLM_MODEL_ID=
# 이미지 생성 모델 (예: stabilityai/stable-diffusion-xl-base-1.0 등)
IMAGE_MODEL_ID=
MODEL_CACHE_DIR=./models/checkpoints
DEVICE=cuda            # cuda | cpu | mps
DTYPE=bfloat16

# ===== 외부 API 키 (필요 시) =====
HUGGINGFACE_TOKEN=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ===== Naver API =====
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
