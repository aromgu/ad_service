# cp .env.example .env 후 값 채우기. compose 는 .env 가 없어도 뜨도록 되어 있음.

# ===== API 서버 (core/config.py, env_prefix=AD_) =====
AD_ENVIRONMENT=development
# 생성 결과/업로드 저장 위치. compose 는 이 값을 자체 지정하므로 보통 건드릴 필요 없음.
# AD_OUTPUT_ROOT=/app/var/outputs
# AD_UPLOAD_ROOT=/app/var/uploads
# CORS 허용 오리진 (콤마 구분). 배포 시 프론트 도메인으로 좁힌다.
AD_CORS_ALLOW_ORIGINS=*
# 생성 요청 1건 예산 상한(USD)
AD_BUDGET_CAP_USD=10
# 문구/이미지 공급자: mock | (모델 담당이 추가할 실제 provider)
AD_COPY_PROVIDER=mock
AD_IMAGE_PROVIDER=mock

# ===== 프론트엔드 =====
API_BASE_URL=http://api:8000/api/v1

# ===== 모델 (GPU 이미지 / 학습) =====
VLM_MODEL_ID=
IMAGE_MODEL_ID=
MODEL_CACHE_DIR=./models/checkpoints
DEVICE=cuda            # cuda | cpu | mps
DTYPE=bfloat16

# ===== 외부 API 키 (필요 시) =====
HUGGINGFACE_TOKEN=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
