# web/backend 전용 환경 변수. `cp .env.example .env` 후 채운다.

# ===== App =====
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# 프론트엔드 오리진 (CORS). 쉼표로 여러 개.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===== Auth =====
# 운영 배포 시 반드시 교체할 것. 32바이트 이상 권장 (`openssl rand -hex 32`).
JWT_SECRET=dev-only-change-me
JWT_EXPIRE_MINUTES=10080
# 토큰 없이 들어온 요청을 데모 계정으로 처리 (개발용). 운영에선 false.
ALLOW_DEMO_USER=true

# ===== Storage =====
DATABASE_URL=sqlite:///./data/app.db
UPLOAD_DIR=./uploads

# ===== Generation provider =====
# mock  — 내장 목업 (Gu/Park 모델 서빙이 준비되기 전까지 사용)
# remote — 아래 REMOTE_GENERATION_URL 의 FastAPI 추론 서버 호출
GENERATION_PROVIDER=mock
REMOTE_GENERATION_URL=http://localhost:8100
# 목업 생성 총 소요 시간(초). 데모 시 줄이면 빠르게 확인 가능.
MOCK_DURATION_SECONDS=12

# ===== 네이버 커머스 API =====
# 커머스API센터에서 발급받은 애플리케이션 키.
# CLIENT_SECRET 은 bcrypt salt 형식($2a$04$...)이며 전자서명에 그대로 쓰인다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# SELF — 내 스토어(account_id 를 보내지 않는다) / SELLER — 대행(account_id 필수)
NAVER_ACCOUNT_TYPE=SELF
NAVER_ACCOUNT_ID=
# ⚠️ "네이버에 상품 등록"은 항상 진짜 스토어에 상품을 만든다 (연습 모드 없음).
